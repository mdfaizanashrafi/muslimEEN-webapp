# MuslimEEN Environment Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Backend API URL (for server-side API calls)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Frontend URL (for callbacks and CORS)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:8080

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXX
# NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=xxxxxxxx
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxx

# ============================================================================
# BACKEND CONFIGURATION (for E2E tests)
# ============================================================================

# Test database URL
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/muslimeen_test

# Playwright base URL for E2E tests
PLAYWRIGHT_BASE_URL=http://localhost:8080

# CI Environment flag
CI=false
