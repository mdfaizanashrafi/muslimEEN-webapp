# ============================================
# MuslimEEN - Git Ignore
# ============================================

# ============================================
# OS Generated Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# IDEs and Editors
# ============================================
# VS Code
.vscode/
*.code-workspace
.history/

# JetBrains (WebStorm, PyCharm, IntelliJ)
.idea/
*.iml
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ============================================
# Environment and Secrets
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example

# Secret keys and certificates
*.pem
*.key
*.crt
*.csr
secrets/
credentials/

# ============================================
# Node.js / JavaScript
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log*

# Build outputs
dist/
build/
.next/
.nuxt/
.cache/
.parcel-cache/

# Coverage reports
coverage/
.nyc_output/

# ============================================
# Python
# ============================================
# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Allow frontend/lib for Next.js utilities
!frontend/lib/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ============================================
# Logs
# ============================================
logs/
*.log
log/
*.log.*

# ============================================
# Databases
# ============================================
*.sqlite
*.sqlite3
*.db
*.sql

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ============================================
# Docker
# ============================================
.dockerignore
docker-compose.override.yml

# ============================================
# Deployment
# ============================================
.vercel
.netlify
firebase.json
.aws/
.terraform/
*.tfstate
*.tfstate.*

# ============================================
# E2E Testing (Playwright)
# ============================================
e2e/test-results/
e2e/playwright-report/
e2e/test-results.xml
e2e/playwright/.cache/

# ============================================
# Misc
# ============================================
*.pid
*.seed
*.pid.lock
.lock-wscript
.node_repl_history
*.tgz
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
