# ============================================================================
# MuslimEEN - Centralized Git Ignore
# ============================================================================
# This single .gitignore file handles all subdirectories
# Place project-specific patterns in the appropriate sections below
# ============================================================================

# ============================================================================
# OS Generated Files
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================================================
# IDEs and Editors
# ============================================================================
# VS Code
.vscode/
*.code-workspace
.history/

# JetBrains (WebStorm, PyCharm, IntelliJ)
.idea/
*.iml
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ============================================================================
# Environment and Secrets (ALL DIRECTORIES)
# ============================================================================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example

# Secret keys and certificates
*.pem
*.key
*.crt
*.csr
secrets/
credentials/

# ============================================================================
# Node.js / JavaScript (Frontend, Backend, Root)
# ============================================================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
.next/
.nuxt/
.cache/
.parcel-cache/

# Coverage reports
coverage/
.nyc_output/

# Lock files (comment out if you want to track lock files)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================================================
# Backend Specific (Node.js/Express)
# ============================================================================
backend/node_modules/
backend/dist/
backend/build/
backend/.env
backend/.env.*
backend/coverage/
backend/logs/
backend/*.log
backend/tmp/
backend/temp/

# ============================================================================
# Frontend Specific (Next.js)
# ============================================================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.*
frontend/coverage/

# Next.js specific
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# ============================================================================
# Python (if any scripts use Python)
# ============================================================================
# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
develop-eggs/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Test/coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# mypy
.mypy_cache/

# ============================================================================
# Logs (All directories)
# ============================================================================
logs/
*.log
log/
*.log.*

# ============================================================================
# Databases
# ============================================================================
*.sqlite
*.sqlite3
*.db
*.sql

# ============================================================================
# Temporary Files
# ============================================================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ============================================================================
# Docker
# ============================================================================
.dockerignore
docker-compose.override.yml

# ============================================================================
# Deployment Platforms
# ============================================================================
.vercel
.netlify
.firebase/
.aws/
.terraform/
*.tfstate
*.tfstate.*

# ============================================================================
# E2E Testing (Playwright)
# ============================================================================
e2e/test-results/
e2e/playwright-report/
e2e/test-results.xml
e2e/playwright/.cache/

# Screenshots and videos on failure
e2e/*.png
e2e/*.webm
e2e/*.zip
e2e/*.trace

# ============================================================================
# Misc
# ============================================================================
*.pid
*.seed
*.pid.lock
.lock-wscript
.node_repl_history
*.tgz
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ============================================================================
# Project Specific - MuslimEEN
# ============================================================================
# Large binary files that shouldn't be tracked
*.mp4
*.mov
*.avi
*.wmv

# Local development scripts with personal configs
*.local.ps1
*.local.sh

# Generated documentation that should be rebuilt
docs/generated/

# Database backups
backups/
*.backup.sql
*.dump
.env*.local
