# MuslimEEN Backend Environment Configuration
# SECURITY: All secrets must be changed in production!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3001

# Trusted proxy IPs for production (comma-separated)
# Leave empty in development
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=muslimeen
DB_USER=muslimeen
# SECURITY: Must be strong, unique password in production
DB_PASSWORD=your_secure_password_here_min_16_chars

# =============================================================================
# CLERK AUTHENTICATION (REQUIRED)
# =============================================================================
# Get from: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Webhook Secret (for webhook verification)
# Get from: Clerk Dashboard > Webhooks > Your Endpoint > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# =============================================================================
# JWT CONFIGURATION (LEGACY - Clerk handles auth now)
# =============================================================================
# SECURITY: Minimum 32 characters, cryptographically random
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: Clerk is now used for authentication. This is kept for backward compatibility.
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Password hashing strength (higher = slower but more secure)
BCRYPT_ROUNDS=12

# CSRF Protection Secret
# SECURITY: Must be unique and secret in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=your-csrf-secret-key-min-32-chars

# Cookie Signing Secret
# SECURITY: Must be changed in production, minimum 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=your-cookie-secret-key-min-32-chars-change-in-production

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Production frontend URLs (comma-separated)
FRONTEND_URL=https://app.muslimeen.org
FRONTEND_URLS=https://muslimeen.org,https://www.muslimeen.org

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_TO_CONSOLE=true

# =============================================================================
# ERROR TRACKING (Sentry)
# =============================================================================
# Get your DSN from https://sentry.io/settings/projects/
# Using same project as frontend for unified error tracking
SENTRY_DSN=https://de4361229b1bee21d70480bf3382b2b1@o4511066862780416.ingest.us.sentry.io/4511066874773504

# =============================================================================
# ALERTING CONFIGURATION
# =============================================================================
# Webhook URL for security alerts (Slack, PagerDuty, etc.)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@muslimeen.org
SMTP_PASSWORD=your_smtp_password

# =============================================================================
# WEBAUTHN CONFIGURATION
# =============================================================================
WEBAUTHN_RP_NAME=MuslimEEN
WEBAUTHN_RP_ID=muslimeen.org

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
ADMIN_EMAIL=admin@muslimeen.org

# =============================================================================
# FEATURE FLAGS (Clerk Migration)
# =============================================================================
# Enable Clerk authentication (gradual rollout)
USE_CLERK_AUTH=false

# Enable Clerk webhooks processing
USE_CLERK_WEBHOOKS=false

# Enable magic link authentication for migrated users
USE_MAGIC_LINKS=true

# Enable dual-auth mode (both old JWT and Clerk work)
DUAL_AUTH_MODE=false

# Percentage of users using Clerk (0-100) for gradual rollout
CLERK_ROLLOUT_PERCENTAGE=0

# CRITICAL: Disable legacy auth - ONLY enable after 7-14 days of zero detections
# WARNING: This will BLOCK all legacy JWT/CSRF/cookie auth
DISABLE_LEGACY_AUTH=false

# Enable legacy auth detection (logs usage to Sentry)
# Keep enabled until ready to cleanup
ENABLE_LEGACY_AUTH_DETECTION=true

# =============================================================================
# MIGRATION SETTINGS
# =============================================================================
# Dry run mode - log actions but don't make changes
MIGRATION_DRY_RUN=true

# Number of users to process per batch
MIGRATION_BATCH_SIZE=100

# Delay between API calls (ms) - for rate limiting
MIGRATION_DELAY_MS=100

# =============================================================================
# INTERNAL API CONFIGURATION (Service-to-Service)
# =============================================================================
# Internal API base URL (for service-to-service calls)
INTERNAL_API_URL=http://localhost:3001/api/internal

# Internal API key for service authentication
# Generate with: npx ts-node scripts/create-api-key.ts --name="ServiceName" --scope=admin
# SECURITY: This key has internal access - keep it secret!
INTERNAL_API_KEY=

# =============================================================================
# SYSTEM SAFETY MODE (Read-Only)
# =============================================================================
# Enable read-only mode - blocks all write operations (POST, PUT, DELETE)
# Use during maintenance, data consistency concerns, or emergency situations
# When true: Only GET, HEAD, OPTIONS requests are allowed
# When false: All HTTP methods work normally (default)
SYSTEM_READ_ONLY=false

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. CLERK_SECRET_KEY: Keep this secret - it has full admin access to your Clerk org
#    Never expose this in frontend code or commit to public repos
#
# 2. CLERK_WEBHOOK_SECRET: Required for secure webhook verification
#    Get this from Clerk Dashboard > Webhooks > Your Endpoint
#
# 3. JWT_SECRET (LEGACY): Only needed for backward compatibility
#    Clerk is now the primary authentication provider
#
# 4. DB_PASSWORD: Must be strong (16+ chars), no dictionary words
#    Never use default passwords like 'postgres', 'password', 'admin'
#
# 5. CSRF_SECRET: Must be at least 32 characters, unique per deployment
#    Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 6. COOKIE_SECRET: Must be at least 32 characters, unique per deployment
#    Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 7. In production (NODE_ENV=production):
#    - All secrets MUST be changed from defaults
#    - CORS origins are strictly enforced
#    - Stack traces are not exposed in errors
#    - Rate limiting is more aggressive
#    - Security headers are strictly enforced
#
# 8. Never commit this file with real secrets to version control!
#
# =============================================================================
