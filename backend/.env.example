# MuslimEEN Backend Environment Configuration
# SECURITY: All secrets must be changed in production!
# AUTHENTICATION: Clerk only (legacy JWT removed)

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3001

# Trusted proxy IPs for production (comma-separated)
# Leave empty in development
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://muslimeen:your_secure_password@localhost:5432/muslimeen

# Connection pool size (optional)
DB_POOL_MAX=20

# =============================================================================
# CLERK AUTHENTICATION (REQUIRED)
# =============================================================================
# Get from: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Webhook Secret (for webhook verification)
# Get from: Clerk Dashboard > Webhooks > Your Endpoint > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# =============================================================================
# INVITE SYSTEM SECURITY (REQUIRED)
# =============================================================================
# Minimum 32 characters, cryptographically random
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_TOKEN_SECRET=your-invite-token-secret-min-32-chars-change-in-production

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Production frontend URLs (comma-separated)
FRONTEND_URL=https://app.muslimeen.org
FRONTEND_URLS=https://muslimeen.org,https://www.muslimeen.org

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# ERROR TRACKING (Sentry) - Optional but recommended
# =============================================================================
# Get your DSN from https://sentry.io/settings/projects/
SENTRY_DSN=

# =============================================================================
# RATE LIMITING (Redis) - Optional
# =============================================================================
# Redis URL for distributed rate limiting in production
# REDIS_URL=redis://localhost:6379

# =============================================================================
# INTERNAL API CONFIGURATION (Service-to-Service)
# =============================================================================
# Internal API base URL (for service-to-service calls)
INTERNAL_API_URL=http://localhost:3001/api/internal

# Internal API key for service authentication
# Generate with: npx ts-node scripts/create-api-key.ts --name="ServiceName" --scope=admin
# SECURITY: This key has internal access - keep it secret!
INTERNAL_API_KEY=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable Clerk webhooks processing
USE_CLERK_WEBHOOKS=false

# =============================================================================
# SYSTEM SAFETY MODE (Read-Only)
# =============================================================================
# Enable read-only mode - blocks all write operations (POST, PUT, DELETE)
# Use during maintenance, data consistency concerns, or emergency situations
SYSTEM_READ_ONLY=false

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# 1. CLERK_SECRET_KEY: Keep this secret - it has full admin access to your Clerk org
#    Never expose this in frontend code or commit to public repos
#
# 2. CLERK_WEBHOOK_SECRET: Required for secure webhook verification
#    Get this from Clerk Dashboard > Webhooks > Your Endpoint
#
# 3. INVITE_TOKEN_SECRET: Used for signing invite tokens
#    Must be at least 32 characters, unique per deployment
#    Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 4. DATABASE_URL: Must use postgresql:// protocol
#    Example: postgresql://user:pass@host:5432/dbname
#
# 5. In production (NODE_ENV=production):
#    - All secrets MUST be changed from defaults
#    - CORS origins are strictly enforced
#    - Stack traces are not exposed in errors
#    - Rate limiting is more aggressive
#    - Security headers are strictly enforced
#
# 6. Never commit this file with real secrets to version control!
#
# =============================================================================
