# MuslimEEN Production Environment
# Copy this to .env.production and fill in values from your deployment platforms

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=10000

# Your frontend URL (Vercel domain)
FRONTEND_URL=https://your-app.vercel.app

# =============================================================================
# NEON DATABASE (https://neon.tech)
# =============================================================================
# Copy connection string from Neon dashboard
DATABASE_URL=postgresql://user:password@host.neon.tech/muslimeen?sslmode=require

# Or use individual components
DB_HOST=host.neon.tech
DB_PORT=5432
DB_NAME=muslimeen
DB_USER=user
DB_PASSWORD=password

# =============================================================================
# UPSTASH REDIS (https://upstash.com)
# =============================================================================
# Copy Redis URL from Upstash dashboard
REDIS_URL=rediss://default:password@host.upstash.io:port

# Alternative: Upstash REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# =============================================================================
# SECURITY SECRETS (Generate these!)
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_character_hex_secret_here
CSRF_SECRET=your_64_character_hex_secret_here
COOKIE_SECRET=your_64_character_hex_secret_here

# =============================================================================
# PASSWORD HASHING
# =============================================================================
BCRYPT_ROUNDS=12

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true

# =============================================================================
# LOGGING (Sentry optional)
# =============================================================================
LOG_LEVEL=warn
# SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# EMAIL (Optional - for notifications)
# =============================================================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=noreply@yourdomain.com
