# Test Environment for Modular Architecture Migration
# Use this file to test modular implementations

NODE_ENV=test
PORT=3002

# Database Configuration (use test database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=muslimeen_test_modular
DB_USER=muslimeen
DB_PASSWORD=test_password

# JWT Configuration
JWT_SECRET=test-jwt-secret-for-modular-migration-tests
JWT_EXPIRES_IN=1h

# Security
BCRYPT_ROUNDS=4
CSRF_SECRET=test-csrf-secret

# Logging
LOG_LEVEL=error

# ============================================================================
# FEATURE FLAGS - Enable modules for testing
# Set to 'true' to test modular implementation
# Set to 'false' to test legacy implementation
# ============================================================================

# IAM Module
USE_MODULAR_IAM=true

# Profile Module
USE_MODULAR_PROFILE=true

# Trust Module
USE_MODULAR_TRUST=true

# Network Module
USE_MODULAR_NETWORK=true

# Notifications Module
USE_MODULAR_NOTIFICATIONS=false

# Invitations Module
USE_MODULAR_INVITATIONS=false

# Marketplace Module
USE_MODULAR_MARKETPLACE=true

# Islamic Finance Module
USE_MODULAR_ISLAMIC_FINANCE=true
