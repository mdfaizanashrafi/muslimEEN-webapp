# ============================================================================
# MuslimEEN Frontend Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED FOR SEO & PRODUCTION
# ----------------------------------------------------------------------------

# Your production domain (REQUIRED for sitemap, robots.txt, Open Graph)
NEXT_PUBLIC_BASE_URL=https://muslimeen.org

# Google Search Console verification code
# Get this from: https://search.google.com/search-console
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# ----------------------------------------------------------------------------
# ANALYTICS & TRACKING (Optional but Recommended)
# ----------------------------------------------------------------------------

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Get from: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (Optional)
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Microsoft Clarity Project ID (Optional - for heatmaps)
# Get from: https://clarity.microsoft.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------

# Backend API URL
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# For production (uncomment and set your backend URL):
# NEXT_PUBLIC_API_URL=https://api.muslimeen.org/api

# ----------------------------------------------------------------------------
# CLERK AUTHENTICATION (REQUIRED)
# ----------------------------------------------------------------------------

# Get from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs (must match your Clerk Dashboard settings)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ----------------------------------------------------------------------------
# ADVANCED SEO (Optional)
# ----------------------------------------------------------------------------

# Hotjar Site ID (for heatmaps and recordings)
# NEXT_PUBLIC_HOTJAR_SITE_ID=

# Facebook Domain Verification (if using Facebook pixels)
# NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# ----------------------------------------------------------------------------
# ERROR TRACKING (Sentry)
# ----------------------------------------------------------------------------

# Sentry DSN for error tracking
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
